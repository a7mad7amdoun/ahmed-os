# ── Ahmed OS ──────────────────────────────────────────────────
#
# LOCAL: leave DATABASE_URL unset. The app runs on PGlite, a real
# Postgres stored in ./.data/pg. Nothing to install, nothing to
# sign up for. Your data never leaves the machine.
#
# HOSTED: set both of these.

# Postgres connection string (Neon, Supabase or Vercel Postgres).
# Required in production — the app refuses to start without it.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs your login cookie. Must be 32+ characters and secret.
# Generate one with:  openssl rand -base64 32
# SESSION_SECRET=""
